# AgentOS Kernel Configuration
# Base: Debian kernel config with desktop optimizations

CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_X86=y
CONFIG_INSTRUCTION_DECODER=y
CONFIG_OUTPUT_FORMAT="elf64-x86-64"
CONFIG_LOCKDEP_SUPPORT=y
CONFIG_STACK_HASH_SUPPORT=y
CONFIG_MMU=y
CONFIG_ZONE_DMA=y
CONFIG_ARCH_MMEMMAP=y
CONFIG_ARCH_MPROBE=y
CONFIG_X86_64=y

# Processor type and features
CONFIGSMP=y
CONFIG_NR_CPUS=256
CONFIG_SCHED_MC=y
CONFIG_SCHED_SMT=y

# Power management and ACPI
CONFIG_ACPI=y
CONFIG_ACPI_PROC_EVENT_POWER=y
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_FAN=y
CONFIG_ACPI_PROCESSOR=y
CONFIG_ACPI_PCI=y
CONFIG_ACPI_THERMAL=y

# Bus options
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCI_REALLOC_ENABLE_AUTO=y

# Device Drivers
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_INPUT=y

# File systems
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FORCED_EXT4=y
CONFIG_FSCACHE=y
CONFIG_ISO9660_FS=y
CONFIG_FUSE_FS=y
CONFIG_OVERLAY_FS=y

# Network support
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_CORE=y
CONFIG_INET=y
CONFIG_IP_MULTICAST=y
CONFIG_NETFILTER=y

# Console drivers
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# Boot options
CONFIG_INITRAMFS_SOURCE=""
CONFIG_INITRAMFS_ROOT_UID=0
CONFIG_INITRAMFS_ROOT_GID=0
CONFIG_RD_GZIP=y
CONFIG_RD_BZIP2=y
CONFIG_RD_LZMA=y
CONFIG_RD_ZSTD=y

# Security options
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_PATH=y
CONFIG_LSM_MMAP_MIN_ADDR=0